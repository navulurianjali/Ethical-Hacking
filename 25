cat > square.sh <<'EOF'
#!/bin/bash
read -p "Enter a number: " n
echo "Square = $((n*n))"
EOF
chmod +x square.sh
./square.sh

cat > biggest.sh <<'EOF'
#!/bin/bash
read -p "Enter three numbers: " a b c
if [ $a -ge $b ] && [ $a -ge $c ]; then
    echo "Biggest = $a"
elif [ $b -ge $a ] && [ $b -ge $c ]; then
    echo "Biggest = $b"
else
    echo "Biggest = $c"
fi
EOF
chmod +x biggest.sh
./biggest.sh
